# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Only these Telegram user IDs may command the bot (comma separated). REQUIRED.
TELEGRAM_ALLOWED_USERS=123456789

# ─── LLM provider ────────────────────────────────────────────────────────────
# one of: agentrouter | openai | anthropic | gemini | openrouter
LLM_PROVIDER=agentrouter
LLM_MODEL=claude-opus-5
# get yours at https://agentrouter.org/console
LLM_API_KEY=sk-...

# Optional. Leave blank to use the provider default:
#   agentrouter -> https://agentrouter.org/v1
#   openai      -> https://api.openai.com/v1
#   openrouter  -> https://openrouter.ai/api/v1
# OpenAI-compatible gateways REQUIRE the trailing /v1.
# China mainland mirror for agentrouter: https://ps.air-outer.com/v1
# LLM_BASE_URL=https://agentrouter.org/v1

# Not sure of the exact model id? Run:  python run.py --models claude

# ─── Browser ─────────────────────────────────────────────────────────────────
# cdp    = connect to an already-running Chromium (REQUIRED on Termux)
# launch = let Playwright launch its own browser (desktop Linux / VPS only)
BROWSER_MODE=cdp
CDP_URL=http://127.0.0.1:9222
HEADLESS=true
NAV_TIMEOUT_MS=30000

# ─── Safety ──────────────────────────────────────────────────────────────────
# true = plan everything but never actually click/fill
DRY_RUN=false
# hard cap on browser actions per run
MAX_ACTIONS=120
# max pages the discovery agent will visit
MAX_DISCOVERY_PAGES=25
MAX_DISCOVERY_DEPTH=3
# how long a human gate (OTP/CAPTCHA) waits for you, in seconds
HUMAN_GATE_TIMEOUT=600

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
LOG_LEVEL=INFO
